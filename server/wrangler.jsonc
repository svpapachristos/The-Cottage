// The Cottage server: one Cloudflare Worker that serves the app, its API, sign-in, Munin's AI, and the Claude connector.
// The database (D1), the sign-in store (KV) and the AI binding are created automatically on the first deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-cottage",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "the-cottage-db" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "ai": { "binding": "AI" },
  "vars": { "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct" },
  "observability": { "enabled": true }
}
